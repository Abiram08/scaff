def run_agent() -> None:
    """Run the agent with multi-turn conversation support."""
    _print_header()

    api_key = os.environ.get(API_KEY_ENV)
    if not api_key:
        _print_no_api_key()
        raise SystemExit(1)

    client = _init_client(api_key)
    messages: list[dict[str, Any]] = []

    global _memory
    if _memory:
        messages = _memory.load()
        if messages:
            print(f"  [Resumed conversation with {_memory.count_messages()} prior messages]")
            print()

    print("Type your request (or 'exit' to quit):")
    print()

    while True:
        try:
            user_input = input("You: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            print("[OK] Goodbye!")
            print()
            break

        if not user_input:
            continue

        if user_input.lower() in ("exit", "quit", "bye", "done"):
            print()
            print("[OK] Goodbye!")
            print()
            break

        messages.append({"role": "user", "content": user_input})

        # Tool call loop
        while True:
            try:
                message = _send_request(client, messages, use_streaming=True)
            except Exception as e:
                print(f"[ERROR] API error: {e}")
                print()
                print("Tips:")
                print(f"  - Check that your {API_KEY_ENV} is valid")
                print("  - Check your account has credits")
                print("  - Try again later if rate limited")
                print()
                break

            if not _parse_tool_calls(message):
                _add_assistant_with_tools(
                    messages,
                    getattr(message, "content", "") or "",
                    [],
                )
                break

            messages, _ = _process_tool_calls(message, messages)

        if _memory:
            _memory.save(messages)

        print()


# Module-level conversation state for API/serve mode
_conversation: list[dict[str, Any]] = []


def chat(message: str) -> str:
    """Process a single message and return the response text.

    Maintains conversation state across calls via module-level _conversation.
    Designed for programmatic/API use (non-streaming, no console output).
    """
    global _conversation
    api_key = os.environ.get(API_KEY_ENV)
    if not api_key:
        return json.dumps({"error": f"{API_KEY_ENV} not set"})

    client = _init_client(api_key)

    global _memory
    if not _conversation:
        _conversation = _memory.load() if _memory else []

    _conversation.append({"role": "user", "content": message})

    response_text = ""
    while True:
        try:
            msg = _send_request(client, _conversation, use_streaming=False)
        except Exception as e:
            return json.dumps({"error": f"API error: {e}"})

        raw_tool_calls = _parse_tool_calls(msg)
        if not raw_tool_calls:
            response_text = getattr(msg, "content", "") or ""
            _add_assistant_with_tools(_conversation, response_text, [])
            break

        _conversation, _ = _process_tool_calls(msg, _conversation)

    if _memory:
        _memory.save(_conversation)

    return response_text


if __name__ == "__main__":
    try:
        run_agent()
    except KeyboardInterrupt:
        print()
        print("[OK] Goodbye!")
        sys.exit(0)
