def _stream_response(
    client: Any,
    messages: list[dict[str, Any]],
) -> Any:
    """Send request with streaming and return the complete message."""
    response = client.chat.completions.create(
        model=MODEL,
        max_tokens=MAX_TOKENS,
        temperature=TEMPERATURE,
        messages=_build_messages(SYSTEM_PROMPT, messages),
        tools=get_tool_definitions(),
        tool_choice="auto",
        stream=True,
    )

    collected_content = []
    tool_calls_data = {}
    print()
    print("[AGENT] ", end="", flush=True)

    for chunk in response:
        delta = chunk.choices[0].delta if chunk.choices else None
        if not delta:
            continue

        if delta.content:
            collected_content.append(delta.content)
            sys.stdout.write(delta.content)
            sys.stdout.flush()

        if delta.tool_calls:
            for tc in delta.tool_calls:
                idx = tc.index
                if idx not in tool_calls_data:
                    tool_calls_data[idx] = {
                        "id": tc.id or "",
                        "function": {"name": "", "arguments": ""},
                    }
                if tc.id:
                    tool_calls_data[idx]["id"] = tc.id
                if tc.function:
                    if tc.function.name:
                        tool_calls_data[idx]["function"]["name"] += tc.function.name
                    if tc.function.arguments:
                        tool_calls_data[idx]["function"]["arguments"] += tc.function.arguments

    print()
    print()

    # Reconstruct assistant message
    class ToolCallObj:
        def __init__(self, data):
            self.id = data["id"]
            self.type = "function"
            self.function = type("Func", (), {
                "name": data["function"]["name"],
                "arguments": data["function"]["arguments"],
            })()

    class MessageObj:
        def __init__(self, content, tool_calls):
            self.content = content or ""
            self.tool_calls = tool_calls or None

    tcs = [ToolCallObj(data) for data in sorted(tool_calls_data.values(), key=lambda x: list(tool_calls_data.keys())[list(tool_calls_data.values()).index(x)])]
    return MessageObj("".join(collected_content), tcs if tcs else None)


def _send_request(
    client: Any,
    messages: list[dict[str, Any]],
    use_streaming: bool = True,
) -> Any:
    """Send a chat completion request, optionally streaming."""
    if use_streaming:
        return _stream_response(client, messages)

    response = client.chat.completions.create(
        model=MODEL,
        max_tokens=MAX_TOKENS,
        temperature=TEMPERATURE,
        messages=_build_messages(SYSTEM_PROMPT, messages),
        tools=get_tool_definitions(),
        tool_choice="auto",
    )
    return response.choices[0].message

