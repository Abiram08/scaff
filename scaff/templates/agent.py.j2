def _process_tool_calls(
    message: Any,
    messages: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], bool]:
    """Process tool calls from an assistant message.

    Returns (updated_messages, has_more_tool_calls).
    """
    raw_tool_calls = _parse_tool_calls(message)
    if not raw_tool_calls:
        return messages, False

    _add_assistant_with_tools(messages, getattr(message, "content", "") or "", raw_tool_calls)

    for tc_id, name, args_json in raw_tool_calls:
        try:
            args = json.loads(args_json)
        except json.JSONDecodeError:
            args = {}

        print(f"[TOOL] Running: {name}")
        if args:
            for k, v in args.items():
                print(f"       {k}: {v}")

        result = execute_tool(name, args)
        summary = result[:200].replace("\n", " ")
        print(f"       -> {summary}{'...' if len(result) > 200 else ''}")

        _add_tool_call_message(messages, name, args, result, tc_id)

    return messages, True


