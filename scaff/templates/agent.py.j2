def _stream_response(
    client: Any,
    messages: list[dict[str, Any]],
) -> Any:
    """Send request with streaming and return the complete message."""
    with client.messages.stream(
        model=MODEL,
        max_tokens=MAX_TOKENS,
        temperature=TEMPERATURE,
        system=SYSTEM_PROMPT,
        messages=messages,
        tools=get_tool_definitions(),
    ) as stream:
        text_content = ""
        print()
        print("[AGENT] ", end="", flush=True)
        for text_delta in stream.text_stream:
            text_content += text_delta
            sys.stdout.write(text_delta)
            sys.stdout.flush()

    print()
    print()
    final = stream.get_final_message()

    # Wrap in a compatible object
    class MessageObj:
        def __init__(self, msg):
            self.content = text_content
            self.model = getattr(msg, "model", "")
            self.stop_reason = getattr(msg, "stop_reason", "")
            self.tool_calls = None

    return MessageObj(final)


def _send_request(
    client: Any,
    messages: list[dict[str, Any]],
    use_streaming: bool = True,
) -> Any:
    """Send a messages request, optionally streaming."""
    if use_streaming:
        return _stream_response(client, messages)

    response = client.messages.create(
        model=MODEL,
        max_tokens=MAX_TOKENS,
        temperature=TEMPERATURE,
        system=SYSTEM_PROMPT,
        messages=messages,
        tools=get_tool_definitions(),
    )

    class MessageObj:
        def __init__(self, msg):
            self.content = ""
            self.tool_calls = None
            if hasattr(msg, "content") and msg.content:
                text_parts = [b.text for b in msg.content if hasattr(b, "type") and b.type == "text"]
                self.content = "".join(text_parts)
                if any(hasattr(b, "type") and b.type == "tool_use" for b in msg.content):
                    self.tool_calls = msg

    return MessageObj(response)

