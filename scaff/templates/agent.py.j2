import json
import os
import sys
from typing import Any

import openai

# Import generated tools
from tools import *

# Configuration - Edit these to customize your agent
SYSTEM_PROMPT = """{{ system_prompt }}"""

MODEL = "gpt-4o"
MAX_TOKENS = 4096
TEMPERATURE = 0.7


def get_tool_definitions() -> list[dict[str, Any]]:
    """Return OpenAI-compatible tool definitions."""
    return {{ tools | tojson(indent=2) }}


def execute_tool(name: str, args: dict[str, Any]) -> str:
    """Execute a tool by name with the given arguments."""
    tools_map = {
{%- for tool in tools %}
        "{{ tool.name }}": {{ tool.name }},
{%- endfor %}
    }

    if name not in tools_map:
        return json.dumps({"error": f"Tool '{name}' not found"})

    try:
        result = tools_map[name](**args)
        return str(result)
    except Exception as e:
        return json.dumps({"error": str(e)})


def run_agent(user_message: str) -> None:
    """Run the agent with a user-provided message."""
    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key:
        print("[ERROR] OPENAI_API_KEY environment variable not set")
        print("Set it with: export OPENAI_API_KEY='your-key'")
        sys.exit(1)

    client = openai.OpenAI(api_key=api_key)

    messages: list[dict[str, Any]] = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": user_message},
    ]

    print(f"\n[AGENT] Starting task...\n")

    while True:
        response = client.chat.completions.create(
            model=MODEL,
            max_tokens=MAX_TOKENS,
            temperature=TEMPERATURE,
            messages=messages,
            tools=get_tool_definitions(),
            tool_choice="auto",
        )

        message = response.choices[0].message

        # No tool calls -> we have the final answer
        if not message.tool_calls:
            if message.content:
                print(f"\n[RESULT] {message.content}\n")
            break

        # Process each tool call
        messages.append(message)
        for tc in message.tool_calls:
            name = tc.function.name
            try:
                args = json.loads(tc.function.arguments)
            except json.JSONDecodeError:
                args = {}

            print(f"[TOOL] {name}")
            if args:
                print(f"  Args: {json.dumps(args, indent=2)}")

            result = execute_tool(name, args)
            print(f"  Result: {result[:200]}{'...' if len(result) > 200 else ''}")

            messages.append({
                "role": "tool",
                "tool_call_id": tc.id,
                "content": result,
            })

    print("\n[DONE]")


def main() -> None:
    """Entry point."""
    user_input = "{{ description }}"
    run_agent(user_input)


if __name__ == "__main__":
    main()
