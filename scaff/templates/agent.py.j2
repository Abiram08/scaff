import json
import os
import platform
import sys
from typing import Any

from openai import APIError, OpenAI

from tools import *

# ── Configuration ─────────────────────────────────────────────
# Edit these to customize your agent's behavior

SYSTEM_PROMPT = """{{ system_prompt }}"""

MODEL = "gpt-4o"
MAX_TOKENS = 4096
TEMPERATURE = 0.7


def get_tool_definitions() -> list[dict[str, Any]]:
    """Return OpenAI-compatible tool definitions."""
    return [
{%- for tool in tools %}
        {
            "type": "function",
            "function": {
                "name": "{{ tool.name }}",
                "description": "{{ tool.description }}",
                "parameters": {
                    "type": "object",
                    "properties": {{ tool.parameters | tojson(indent=20) }},
                    "required": {{ tool.required | default([]) | tojson }},
                    "additionalProperties": False,
                },
            },
        },
{%- endfor %}
    ]


def execute_tool(name: str, args: dict[str, Any]) -> str:
    """Execute a tool by name with the given arguments."""
    tools_map = {
{%- for tool in tools %}
        "{{ tool.name }}": {{ tool.name }},
{%- endfor %}
    }

    if name not in tools_map:
        return json.dumps({"error": f"Tool '{name}' not found"})

    try:
        result = tools_map[name](**args)
        return str(result)
    except Exception as e:
        return json.dumps({"error": str(e)})


def _print_header() -> None:
    """Print a friendly welcome header."""
    print()
    print("=" * 55)
    print("  {{ agent_name.replace('-', ' ').title() }}")
    print("=" * 55)
    print(f"  Describe what you want and I will do my best.")
    print("=" * 55)
    print()


def _print_no_api_key() -> None:
    """Print platform-specific instructions for setting the API key."""
    print()
    print("[ERROR] OpenAI API key not found!")
    print()
    print("  You need an API key to run this agent.")
    print()
    print("  Get one here: https://platform.openai.com/api-keys")
    print()

    system = platform.system().lower()
    if system == "windows":
        print("  Then set it in your terminal:")
        print('    $env:OPENAI_API_KEY = "sk-..."')
    else:
        print("  Then set it in your terminal:")
        print('    export OPENAI_API_KEY="sk-..."')

    print()
    print("  Or create a .env file with:")
    print("    OPENAI_API_KEY=sk-...")
    print()


def run_agent() -> None:
    """Run the agent with user input."""
    _print_header()

    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key:
        _print_no_api_key()
        raise SystemExit(1)

    client = OpenAI(api_key=api_key)

    print("What should I do? (type your request)")
    print("(press Ctrl+C to exit)")
    print()

    user_message = input("You: ").strip()
    if not user_message:
        print("[?] No request given. Exiting.")
        return

    messages: list[dict[str, Any]] = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": user_message},
    ]

    print()
    print("[AGENT] Working on it...")
    print()

    while True:
        try:
            response = client.chat.completions.create(
                model=MODEL,
                max_tokens=MAX_TOKENS,
                temperature=TEMPERATURE,
                messages=messages,
                tools=get_tool_definitions(),
                tool_choice="auto",
            )
        except APIError as e:
            print(f"[ERROR] OpenAI API error: {e}")
            print()
            print("Tips:")
            print("  - Check that your API key is valid")
            print("  - Check your OpenAI account has credits")
            print("  - Try again later if rate limited")
            raise SystemExit(1)

        message = response.choices[0].message

        # No tool calls => we have the final answer
        if not message.tool_calls:
            if message.content:
                print()
                print(f"[RESULT]")
                print("-" * 40)
                print(message.content)
                print("-" * 40)
                print()
            break

        # Process each tool call
        messages.append({
            "role": "assistant",
            "content": message.content,
            "tool_calls": [
                {
                    "id": tc.id,
                    "type": "function",
                    "function": {
                        "name": tc.function.name,
                        "arguments": tc.function.arguments or "{}",
                    },
                }
                for tc in message.tool_calls
            ],
        })
        for tc in message.tool_calls:
            name = tc.function.name
            try:
                args = json.loads(tc.function.arguments)
            except json.JSONDecodeError:
                args = {}

            print(f"[TOOL] Running: {name}")
            if args:
                for k, v in args.items():
                    print(f"       {k}: {v}")

            result = execute_tool(name, args)
            summary = result[:200].replace("\n", " ")
            print(f"       -> {summary}{'...' if len(result) > 200 else ''}")

            messages.append({
                "role": "tool",
                "tool_call_id": tc.id,
                "content": result,
            })

    print()
    print("[DONE]")
    print()


if __name__ == "__main__":
    try:
        run_agent()
    except KeyboardInterrupt:
        print()
        print("[OK] Goodbye!")
        sys.exit(0)
