def _stream_response(
    client: Any,
    messages: list[dict[str, Any]],
) -> Any:
    """Send request with streaming and return the complete message."""
    # Build the conversation history
    chat = client.start_chat()
    for msg in messages:
        if msg["role"] == "user":
            chat.send_message(msg.get("parts", [msg.get("content", "")]) if isinstance(msg.get("parts"), list) else msg.get("content", ""))
        elif msg["role"] == "model":
            pass  # history handled by chat

    response = chat.send_message(
        messages[-1].get("content", "") if messages else "",
        stream=True,
    )

    collected_content = []
    print()
    print("[AGENT] ", end="", flush=True)
    for chunk in response:
        if chunk.text:
            collected_content.append(chunk.text)
            sys.stdout.write(chunk.text)
            sys.stdout.flush()

    print()
    print()

    class MessageObj:
        def __init__(self, resp, text):
            self.content = text
            self.text = text
            self.tool_calls = None
            if hasattr(resp, "function_calls") and resp.function_calls:
                self.tool_calls = resp

    return MessageObj(response, "".join(collected_content))


