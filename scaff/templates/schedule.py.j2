"""Scheduled agent runner for {{ agent_name }}

Runs the agent on a schedule using APScheduler.
Configure the schedule via SCHEDULE_CRON env var (default: hourly).
"""

import os
import sys
from datetime import datetime

from apscheduler.schedulers.blocking import BlockingScheduler
from agent import chat

# Read the prompt from environment or file
PROMPT = os.environ.get(
    "AGENT_PROMPT",
    "{{ description }}. Run your tools and report findings.",
)
CRON_EXPRESSION = os.environ.get("SCHEDULE_CRON", "{{ schedule_cron }}")


def run_scheduled_task() -> None:
    """Execute the agent and log results."""
    timestamp = datetime.now().isoformat()
    print(f"[{timestamp}] Running scheduled agent: {{ agent_name }}")
    print(f"  Prompt: {PROMPT[:100]}...")

    try:
        result = chat(PROMPT)
        print(f"  Response: {result[:500]}")
        print(f"[{timestamp}] Completed successfully")
    except Exception as e:
        print(f"[{timestamp}] Error: {e}")


if __name__ == "__main__":
    print("=" * 55)
    print("  {{ agent_name.replace('-', ' ').title() }} - Scheduled Runner")
    print("=" * 55)
    print(f"  Schedule: {CRON_EXPRESSION}")
    print(f"  Prompt: {PROMPT[:80]}...")
    print("=" * 55)
    print()

    scheduler = BlockingScheduler()
    scheduler.add_job(
        run_scheduled_task,
        trigger="cron",
        **dict(zip(
            ["year", "month", "day", "week", "day_of_week", "hour", "minute", "second"],
            CRON_EXPRESSION.split(),
        )),
    )

    try:
        run_scheduled_task()  # Run once immediately on startup
        scheduler.start()
    except KeyboardInterrupt:
        print()
        print("[OK] Scheduler stopped.")
        sys.exit(0)
